PADDLEOCR_API_TOKEN=replace-with-your-token
PADDLEOCR_MODEL=PaddleOCR-VL-1.6
PADDLEOCR_JOB_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
SAVEPLAN_JWT_SECRET=replace-with-a-long-random-secret
SAVEPLAN_ADMIN_JWT_SECRET=replace-with-another-long-random-secret
SAVEPLAN_DATABASE_URL=postgresql+psycopg://saveplan:password@localhost:5432/saveplan
SAVEPLAN_AUTO_CREATE_TABLES=true
SAVEPLAN_ADMIN_EMAIL=admin@saveplan.vip
SAVEPLAN_ADMIN_PASSWORD=replace-with-a-strong-admin-password
SAVEPLAN_ADMIN_USERNAME=Saveplan Admin
SAVEPLAN_DATA_DIR=./data
SAVEPLAN_PUBLIC_ORIGINS=http://localhost:5173
